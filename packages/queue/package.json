{
  "name": "@x-scraper/queue",
  "version": "0.0.0",
  "private": true,
  "description": "Durable SQLite-backed job queue with idempotent stages, retries, DLQ, and cost ledger.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
