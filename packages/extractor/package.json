{
  "name": "@x-scraper/extractor",
  "version": "0.0.0",
  "private": true,
  "description": "Versioned extraction prompts + Zod-validated output (entities, claims, relationships).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@x-scraper/core": "workspace:*",
    "@x-scraper/llm": "workspace:*",
    "@x-scraper/queue": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
