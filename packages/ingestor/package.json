{
  "name": "@x-scraper/ingestor",
  "version": "0.0.0",
  "private": true,
  "description": "Per-source-kind ingestors (article/repo/youtube/pdf) behind an Ingestor port.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@x-scraper/core": "workspace:*",
    "jsdom": "^29.0.2",
    "pdfjs-dist": "^5.6.205",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.0.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
