  "ai_analysis": {
    "architecture": {
      "description": "x-scraper is a local-first knowledge graph system built from X.com bookmarks, likes, and posts. It's a TypeScript monorepo that treats a git-tracked Markdown vault as the canonical source of truth, derives a Neo4j graph index from it, and exposes data through CLI, REST, and MCP interfaces. The architecture follows hexagonal principles: each package exposes a port (interface) and adapters implement concrete providers (Gemini/OpenAI for embeddings, Claude for LLM, Neo4j for graph storage, SQLite for queue). All external JSON is Zod-validated at package boundaries. The system handles multi-step extraction pipelines (bookmarks → ingestor → reconciliation → embeddings → graph population) with durable job queueing.",
      "patterns": [
        "Hexagonal architecture (ports and adapters)",
        "Provider pattern (EmbeddingProvider, LlmProvider)",
        "Zod validation at system boundaries",
        "Canonical vault with derived graph index",
        "Durable job queue with cost ledger",
        "Monorepo with clear package responsibilities",
        "Multi-interface exposure (CLI, REST, MCP)"
      ],
      "design_approach": "Hexagonal monorepo with adapter-based provider integration"
    },
