{
  "name": "x-scraper",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first knowledge graph from X.com bookmarks, likes, and posts.",
  "license": "MIT",
  "author": "Pat Patterson <ppatterson@level.agency>",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --filter='./packages/*' run build",
    "spike": "tsx",
    "circular": "madge --circular --extensions ts packages spikes"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.7.0",
    "@eslint/js": "^9.39.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jsdom": "^29.0.2",
    "madge": "^8.0.0",
    "neo4j-driver": "^6.0.1",
    "patchright": "^1.59.4",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
